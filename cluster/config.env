# Settings shared by the laptop script (hyak.ps1) and the Hyak scripts (submit.sh, job.sbatch, setup_env.sh).
# Plain KEY=VALUE lines only: no quotes, no spaces, no $VARIABLES (PowerShell and bash both read this file).

# ssh target. "klone.hyak.uw.edu" is already an alias in ~/.ssh/config with the right user name.
HYAK_HOST=klone.hyak.uw.edu

# Project directory on Hyak: code, data/, results/, logs/, env/ and cache/ all live here.
# Replace CHANGEME with your group (run `hyakalloc` or `groups` on Hyak), e.g. /gscratch/stf/amp206/SemanticWISP.
# Do not use /gscratch/scrubbed: files there are deleted after 21 days without access.
HYAK_DIR=/gscratch/CHANGEME/amp206/SemanticWISP

# Slurm defaults; any of them can be overridden per job (see README). Take account/partition from `hyakalloc`.
# ckpt-all = idle GPUs of other groups: no cost to your allocation, but jobs can be stopped and requeued.
SLURM_ACCOUNT=CHANGEME
SLURM_PARTITION=ckpt-all
SLURM_GPUS=1
SLURM_CPUS=8
SLURM_MEM=32G
SLURM_TIME=8:00:00
