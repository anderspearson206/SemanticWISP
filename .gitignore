# Datasets: ignore the contents of data/, but keep hand-written notes, scripts and notebooks that live there
# (download links are in README.md and data/*/README.md).
data/**
!data/**/
!data/**/*.md
!data/**/*.py
!data/**/*.ipynb

# Reference papers (PDFs, not ours to redistribute)
papers/

# Experiment outputs, Slurm logs, model checkpoints
results/
logs/
*.ckpt
*.pt
*.pth

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Editors, OS, local tool settings
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
slides/